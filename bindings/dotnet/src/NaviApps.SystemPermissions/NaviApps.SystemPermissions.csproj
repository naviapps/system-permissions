<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>NaviApps.SystemPermissions</PackageId>
    <Version>0.1.0</Version>
    <Description>Rust-backed permission values, validation, checking and deterministic state.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PathMap>$(MSBuildProjectDirectory)=/system-permissions/dotnet</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/README.md" />
    <None Include="../../runtimes/$(SystemPermissionsRuntimeIdentifier)/native/$(SystemPermissionsNativeFileName)" Condition="'$(SystemPermissionsRuntimeIdentifier)' != '' and '$(SystemPermissionsNativeFileName)' != ''" Pack="true" PackagePath="runtimes/$(SystemPermissionsRuntimeIdentifier)/native/%(Filename)%(Extension)" />
    <None Include="../../../../ThirdParty/**/*" Exclude="../../../../ThirdParty/**/.DS_Store;../../../../ThirdParty/**/registry-notices.json" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
  <Target Name="RequireSystemPermissionsNativeAsset" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(SystemPermissionsRuntimeIdentifier)' == '' or '$(SystemPermissionsNativeFileName)' == ''" Text="Use the documented SystemPermissions distribution commands to select a source-built native runtime." />
    <Error Condition="!Exists('../../runtimes/$(SystemPermissionsRuntimeIdentifier)/native/$(SystemPermissionsNativeFileName)')" Text="Source-built native runtime is missing. Run the platform bindings tool." />
  </Target>
</Project>
