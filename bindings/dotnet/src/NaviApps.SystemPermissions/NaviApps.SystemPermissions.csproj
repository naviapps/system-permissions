<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>NaviApps.SystemPermissions</PackageId>
    <Version>0.1.0</Version>
    <Description>Rust-backed permission values, validation, checking and deterministic state.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PathMap>$(MSBuildProjectDirectory)=/system-permissions/dotnet</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/README.md" />
    <None Include="$(SystemPermissionsNativeLibrary)" Condition="'$(SystemPermissionsNativeLibrary)' != ''"
          CopyToOutputDirectory="Always" Pack="true"
          PackagePath="runtimes/$(SystemPermissionsRuntimeIdentifier)/native/%(Filename)%(Extension)">
      <Link Condition="'$(OS)' == 'Windows_NT'">system_permissions.dll</Link>
      <Link Condition="'$(OS)' != 'Windows_NT'">libsystem_permissions.dylib</Link>
    </None>
    <None Include="../../../../ThirdParty/**/*" Exclude="../../../../ThirdParty/**/.DS_Store;../../../../ThirdParty/**/registry-notices.json" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
  <Target Name="RequireSystemPermissionsNativeAsset" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(SystemPermissionsRuntimeIdentifier)' == '' or !Exists('$(SystemPermissionsNativeLibrary)')" Text="Use the documented SystemPermissions distribution commands to select a source-built native runtime." />
  </Target>
</Project>
